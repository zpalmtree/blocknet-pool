[Unit]
Description=Blocknet Pool accounting database backup
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
Nice=19
IOSchedulingClass=idle
UMask=0077
# Balances, payouts, blocks and credit history are kept in full. Raw shares and
# the read models derived from them are bulk (~110 GB) and are skipped to keep
# the nightly run light on the live pool.
ExecStart=/bin/sh -c 'set -eu; out=/var/backups/blocknet-pool/blocknet_pool-$(date -u +%%Y%%m%%dT%%H%%M%%SZ).dump; \
  pg_dump -d blocknet_pool -Fc -Z 6 \
    --exclude-table-data=shares --exclude-table-data=share_job_replays \
    --exclude-table-data=share_read_minutes --exclude-table-data=share_read_miners \
    --exclude-table-data=share_read_deltas --exclude-table-data=seen_shares \
    -f "$out.partial"; \
  pg_restore -l "$out.partial" >/dev/null; \
  mv "$out.partial" "$out"'
ExecStartPost=/usr/bin/find /var/backups/blocknet-pool -maxdepth 1 -name 'blocknet_pool-*.dump*' -mtime +7 -delete
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/blocknet-pool

[Install]
WantedBy=multi-user.target
