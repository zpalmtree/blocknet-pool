# Copy to /etc/blocknet/monitoring.env on the server and set the Discord webhook
# and optional bot credentials for chain-height divergence paging.
# Firing critical alerts ping DISCORD_CRITICAL_MENTION_USER_ID (default: the
# chain-divergence user); warnings and resolutions never ping.
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHAIN_DIVERGENCE_CHANNEL_ID=746507379310461010
DISCORD_CHAIN_DIVERGENCE_MENTION_USER_ID=354701063955152898
DISCORD_CRITICAL_MENTION_USER_ID=
